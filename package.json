{
  "name": "omp-mermaid",
  "version": "0.4.0",
  "description": "🧜‍♀️ oh-my-pi extension that renders Mermaid diagrams as ASCII in the TUI (fork of pi-mermaid)",
  "author": "Gurpartap Singh",
  "contributors": [
    "Ary Rabelo"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryrabelo/omp-mermaid.git"
  },
  "homepage": "https://github.com/aryrabelo/omp-mermaid",
  "keywords": [
    "oh-my-pi",
    "omp",
    "pi-extension",
    "mermaid",
    "ascii",
    "tui"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "beautiful-mermaid": "^1.0.0",
    "mermaid": "^11.0.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*"
  },
  "omp": {
